<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 해당 파일에 모든 쿼리문을 작성 -->
<!-- namespace에는 xml파일과 연결할 Mapper interface 파일명을 패키지를 포함하여 적어주세요 -->
<mapper namespace="com.green.backend_plant_comunity.environment.mapper.EnvironmentMapper">
	<resultMap id="environment" type="com.green.backend_plant_comunity.environment.dto.EnvironmentDTO">
        <id     column="ENV_NUM"          property="envNum" />
        <result column="SENSOR_TIME"      property="sensorTime" />
        <result column="TEMPERATURE"      property="temperature" />
        <result column="HUMIDITY"         property="humidity" />
        <result column="ILLUMINANCE"      property="illuminance" />
        <result column="SOIL_MOISTURE"    property="soilMoisture" />
        <result column="HERB_NUM"    property="herbNum" />
        <result column="HERB_NAME"    property="herbName" />
        <association property="memberDTO" resultMap="com.green.backend_plant_comunity.member.mapper.MemberMapper.member" />
    </resultMap>

    <resultMap id="standards" type="com.green.backend_plant_comunity.environment.dto.StandardsDTO">
        <id column="HERB_NUM" property="herbNum"/>
        <result column="HERB_NAME" property="herbName"/>
        <result column="TEMP_MIN" property="tempMin"/>
        <result column="TEMP_MAX" property="tempMax"/>
        <result column="HUMID_MIN" property="humidMin"/>
        <result column="HUMID_MAX" property="humidMax"/>
        <result column="SOIL_MIN" property="soilMin"/>
        <result column="SOIL_MAX" property="soilMax"/>
        <result column="LUX_MIN" property="luxMin"/>
        <result column="LUX_MAX" property="luxMax"/>
        <result column="IMG_NAME" property="imgName"/>
    </resultMap>

    <!--센서데이터 리스트 조회-->
    <select id="getSensorData" resultMap="environment">
        SELECT
            ENV_NUM,
            SENSOR_TIME,
            TEMPERATURE,
            HUMIDITY,
            ILLUMINANCE,
            SOIL_MOISTURE
        FROM SENSOR_DATA
        ORDER BY SENSOR_TIME DESC
    </select>

    <!--작물 표준 값 조회-->
    <select id="getStandardsHerb" resultMap="standards">
        SELECT
        HERB_NUM,
        HERB_NAME,
        TEMP_MIN,
        TEMP_MAX,
        HUMID_MIN,
        HUMID_MAX,
        SOIL_MIN,
        SOIL_MAX,
        LUX_MIN,
        LUX_MAX,
        IMG_NAME
        FROM
        CROP_STANDARDS
        WHERE
        HERB_NUM = #{herbNum}
    </select>

    <!-- 사용자 (memId)가 키우는 작물 목록 조회 -->
    <!-- 센서 데이터가 있는 작물만 목록에 포함됨 -->
    <select id="getUserHerbsByMemId" resultMap="standards">
        SELECT
        CROP_STANDARDS.HERB_NUM,
        CROP_STANDARDS.HERB_NAME
        FROM
        SENSOR_DATA
        JOIN
        CROP_STANDARDS ON SENSOR_DATA.HERB_NUM = CROP_STANDARDS.HERB_NUM
        WHERE
        SENSOR_DATA.MEM_ID = #{memId}
    </select>

    <!-- 특정 작물 (herbNum)에 대한 센서 데이터 리스트 조회 -->
    <select id="getSensorDataByHerbNum" parameterType="int" resultMap="environment">
        SELECT
        ENV_NUM,
        SENSOR_TIME,
        TEMPERATURE,
        HUMIDITY,
        ILLUMINANCE,
        SOIL_MOISTURE,
        HERB_NUM,
        MEM_ID
        FROM
        SENSOR_DATA
        WHERE
        HERB_NUM = #{herbNum}
        ORDER BY SENSOR_TIME ASC
    </select>
</mapper>































